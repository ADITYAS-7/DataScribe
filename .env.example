# Copy this file to .env and fill in real values. Never commit .env.

# --- Snowflake connection ---
SNOWFLAKE_ACCOUNT=your_account_identifier
SNOWFLAKE_USER=your_username
SNOWFLAKE_WAREHOUSE=your_warehouse
SNOWFLAKE_DATABASE=your_database
SNOWFLAKE_SCHEMA=your_schema
SNOWFLAKE_ROLE=your_role

# --- Auth option A: password ---
SNOWFLAKE_PASSWORD=

# --- Auth option B: key-pair (preferred for automation) ---
# Path to a PEM-encoded private key file. Leave SNOWFLAKE_PASSWORD blank if using this.
SNOWFLAKE_PRIVATE_KEY_PATH=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Auth option C: workplace SSO (Okta, Azure AD, ...) ---
# Set to "externalbrowser" to log in through your identity provider in a
# browser window. No password or key needed.
SNOWFLAKE_AUTHENTICATOR=
